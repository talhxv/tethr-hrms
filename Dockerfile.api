# API image for self-hosting (Coolify or any Docker host). Mirrors the Render
# build: install the workspace, build @hrms/shared then @hrms/api, and run the
# compiled server. All configuration comes from environment variables; see
# render.yaml for the full list. Build from the repository root:
#   docker build -f Dockerfile.api -t tethr-api .

FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY packages/shared/package.json packages/shared/
COPY packages/ui/package.json packages/ui/
COPY packages/api/package.json packages/api/
COPY packages/worker/package.json packages/worker/
COPY packages/web/package.json packages/web/
RUN npm ci --ignore-scripts
COPY tsconfig*.json ./
COPY packages/shared packages/shared
COPY packages/api packages/api
RUN npm run build --workspace=packages/shared && npm run build --workspace=packages/api
RUN npm prune --omit=dev --ignore-scripts

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production PORT=3000
COPY --from=build /app/package.json ./
COPY --from=build /app/node_modules node_modules
COPY --from=build /app/packages/shared/package.json packages/shared/
COPY --from=build /app/packages/shared/dist packages/shared/dist
COPY --from=build /app/packages/api/package.json packages/api/
COPY --from=build /app/packages/api/dist packages/api/dist
USER node
EXPOSE 3000
# Liveness: the GraphQL `health` query answers "ok" without touching the database.
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/graphql',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({query:'{health}'})}).then(r=>r.json()).then(j=>process.exit(j.data&&j.data.health==='ok'?0:1)).catch(()=>process.exit(1))"
CMD ["node", "packages/api/dist/main.js"]
